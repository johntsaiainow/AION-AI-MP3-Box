[Unit]
Description=AION AI MP3 Box Headless Player
After=aion-pulseaudio.service
Wants=aion-pulseaudio.service

[Service]
Type=simple
User=aion-audio
Group=audio
Environment=HOME=/var/lib/aion-audio
Environment=XDG_RUNTIME_DIR=/run/aion-pulse
Environment=PULSE_SERVER=unix:/run/aion-pulse/pulse/native
WorkingDirectory=/
ExecStart=/usr/bin/python3 -u /usr/bin/aion-player --standby
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
