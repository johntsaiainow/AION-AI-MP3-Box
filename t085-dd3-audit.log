=== 1. FLASH SCRIPT ===
#!/usr/bin/env bash
set -Eeuo pipefail

DEVICE=/dev/mmcblk0
P1=/dev/mmcblk0p1
P2=/dev/mmcblk0p2
P3=/dev/mmcblk0p3

IMAGE="$HOME/Projects/Yocto-RPi3-Scarthgap/build/tmp/deploy/images/raspberrypi3-64/core-image-aion-mp3-raspberrypi3-64.rootfs.ext4"
BACKUP="$HOME/Projects/AION-AI-MP3-Box/backups/20261117-144643"

EXPECTED_P2_SIZE=790626304
EXPECTED_IMAGE_SIZE=725614592
EXPECTED_P3_UUID=da792082-ddb1-4896-b6fd-0a61a0cc7266

echo "=== AION v0.4.0 SAFE P2 FLASH ==="

# Validate device identity
[[ -b "$DEVICE" && -b "$P1" && -b "$P2" && -b "$P3" ]]

[[ "$(lsblk -bdno SIZE "$P2" | tr -d '[:space:]')" == "$EXPECTED_P2_SIZE" ]]
[[ "$(sudo blkid -s UUID -o value "$P3")" == "$EXPECTED_P3_UUID" ]]
[[ "$(sudo blkid -s LABEL -o value "$P3")" == "AION-MUSIC" ]]

# Verify partition table identity and boundaries
sudo sfdisk --dump "$DEVICE" |
    grep -q '^label-id: 0x076c4a2a$'

sudo sfdisk --dump "$DEVICE" |
    grep -Eq '^/dev/mmcblk0p2 : start= *278528, size= *1544192, type=83$'

# Verify image
[[ -f "$IMAGE" ]]
[[ "$(stat -Lc %s "$IMAGE")" == "$EXPECTED_IMAGE_SIZE" ]]

# Verify backups
(
    cd "$BACKUP"
    sha256sum -c SHA256SUMS
)

# Do not write to mounted partitions
for PART in "$P1" "$P2" "$P3"; do
    if findmnt -rn -S "$PART" >/dev/null; then
        echo "ERROR: $PART is mounted"
        exit 1
    fi
done

echo
echo "=== VERIFY IMAGE FILESYSTEM ==="
e2fsck -fn "$IMAGE"

echo
echo "=== TARGET ==="
lsblk -o NAME,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS "$DEVICE"

echo
echo "WARNING: The existing P2 RootFS will be replaced."
echo "P1 Boot and P3 Music will not be written."

read -r -p 'Type FLASH-AION-P2 to continue: ' CONFIRM
[[ "$CONFIRM" == "FLASH-AION-P2" ]] || exit 1

echo
echo "=== FLASH P2 ONLY ==="
sudo dd if="$IMAGE" of="$P2" \
    bs=4M status=progress conv=fsync

sync

echo
echo "=== CHECK NEW ROOTFS ==="
sudo e2fsck -fy "$P2"

echo
echo "=== EXPAND ROOTFS ==="
sudo resize2fs "$P2"

echo
echo "=== FINAL CHECK ==="
sudo e2fsck -fy "$P2"

echo
echo "=== VERIFY MUSIC PARTITION ==="
sudo blkid "$P3"

echo
echo "AION v0.4.0 P2 FLASH COMPLETE"

=== 2. BACKUP SCRIPT ===
#!/usr/bin/env bash
set -Eeuo pipefail

DEVICE=/dev/mmcblk0
P1=/dev/mmcblk0p1
P2=/dev/mmcblk0p2
P3=/dev/mmcblk0p3

BACKUP="$HOME/Projects/AION-AI-MP3-Box/backups/$(date +%Y%m%d-%H%M%S)"

trap 'echo "ERROR: Backup failed at line $LINENO" >&2' ERR

echo "=== AION SD CARD BACKUP ==="

test -b "$DEVICE"
test -b "$P1"
test -b "$P2"
test -b "$P3"

SIZE=$(lsblk -bdno SIZE "$P2" | tr -d '[:space:]')
LABEL=$(sudo blkid -s LABEL -o value "$P3")
UUID=$(sudo blkid -s UUID -o value "$P3")

echo "P2 size: $SIZE"
echo "P3 label: $LABEL"
echo "P3 UUID: $UUID"

[[ "$SIZE" == "790626304" ]] || {
    echo "ERROR: Unexpected P2 size"
    exit 1
}

[[ "$LABEL" == "AION-MUSIC" ]] || {
    echo "ERROR: Unexpected P3 label"
    exit 1
}

[[ "$UUID" == "da792082-ddb1-4896-b6fd-0a61a0cc7266" ]] || {
    echo "ERROR: Unexpected P3 UUID"
    exit 1
}

mkdir -p "$BACKUP"

echo
echo "=== BACKUP PARTITION TABLE ==="
sudo sfdisk --dump "$DEVICE" > "$BACKUP/partition-table.sfdisk"

echo
echo "=== BACKUP BOOT PARTITION ==="
sudo dd if="$P1" of="$BACKUP/aion-boot-p1.img" \
    bs=4M status=progress conv=fsync

echo
echo "=== BACKUP ROOTFS PARTITION ==="
sudo dd if="$P2" of="$BACKUP/aion-rootfs-p2-before-v030.img" \
    bs=4M status=progress conv=fsync

echo
echo "=== VERIFY BACKUPS ==="
(
    cd "$BACKUP"
    sha256sum aion-boot-p1.img aion-rootfs-p2-before-v030.img > SHA256SUMS
    sha256sum -c SHA256SUMS
)

echo
echo "BACKUP COMPLETE: $BACKUP"

=== 3. BOOTSTRAP ===
#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCES="$ROOT/sources"

source "$ROOT/config/sources.lock"

mkdir -p "$SOURCES"

checkout_layer() {
    local name="$1"
    local url="$2"
    local revision="$3"
    local directory="$SOURCES/$name"

    echo "=== $name ==="

    if [[ ! -d "$directory/.git" ]]; then
        git clone "$url" "$directory"
    fi

    git -C "$directory" fetch origin "$revision"
    git -C "$directory" checkout --detach "$revision"

    test "$(git -C "$directory" rev-parse HEAD)" = "$revision"
}

checkout_layer poky "$POKY_URL" "$POKY_REV"
checkout_layer meta-raspberrypi "$RPI_URL" "$RPI_REV"
checkout_layer meta-openembedded "$OE_URL" "$OE_REV"

echo
echo "=== AION YOCTO SOURCES READY ==="

=== 4. BUILD SCRIPT ===
#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
POKY="$ROOT/sources/poky"
OE="$ROOT/sources/meta-openembedded"
RPI="$ROOT/sources/meta-raspberrypi"
BUILD="$ROOT/build"

if [[ ! -f "$POKY/oe-init-build-env" ]]; then
    echo "ERROR: Yocto sources missing."
    echo "Run ./bootstrap.sh first."
    exit 1
fi

for layer in \
    "$POKY/meta" \
    "$POKY/meta-poky" \
    "$POKY/meta-yocto-bsp" \
    "$RPI" \
    "$OE/meta-oe" \
    "$OE/meta-python" \
    "$OE/meta-networking" \
    "$ROOT/meta-local"
do
    test -f "$layer/conf/layer.conf" || {
        echo "ERROR: Missing layer: $layer"
        exit 1
    }
done

mkdir -p "$BUILD/conf"

if [[ ! -f "$BUILD/conf/bblayers.conf" ]]; then
cat > "$BUILD/conf/bblayers.conf" <<LAYERS
POKY_BBLAYERS_CONF_VERSION = "2"
BBPATH = "\${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \\
    $POKY/meta \\
    $POKY/meta-poky \\
    $POKY/meta-yocto-bsp \\
    $RPI \\
    $OE/meta-oe \\
    $OE/meta-python \\
    $OE/meta-networking \\
    $ROOT/meta-local \\
"
LAYERS
fi

if [[ ! -f "$BUILD/conf/local.conf" ]]; then
cat > "$BUILD/conf/local.conf" <<'CONFIG'
MACHINE = "raspberrypi3-64"
DISTRO = "poky"
INIT_MANAGER = "systemd"

PACKAGE_CLASSES = "package_rpm"

EXTRA_IMAGE_FEATURES = "debug-tweaks"

IMAGE_FSTYPES:append = " wic.bz2"

LICENSE_FLAGS_ACCEPTED:append = " synaptics-killswitch commercial"

BB_NUMBER_THREADS = "4"
CONFIG
fi

echo "=== AION STANDALONE BUILD ==="

cd "$ROOT"

# Yocto initialization defines bitbake and required environment variables.
# Yocto initialization expects some optional shell variables to be unset.
set +u
source "$POKY/oe-init-build-env" "$BUILD"
set -u

MODE="${1:-rootfs}"

case "$MODE" in
    rootfs)
        echo "=== Building and deploying AION ext4 RootFS ==="

        ROOTFS_CONFIG="$(mktemp /tmp/aion-rootfs-XXXXXXXX.conf)"
        trap 'rm -f "$ROOTFS_CONFIG"' EXIT

        cat > "$ROOTFS_CONFIG" <<'ROOTFS'
IMAGE_FSTYPES = "ext4"
IMAGE_FSTYPES:remove = "wic wic.bz2 wic.bmap ext3 tar.bz2"
ROOTFS

        bitbake -R "$ROOTFS_CONFIG" core-image-aion-mp3
        ;;
    full)
        echo "=== Building AION full image ==="
        bitbake core-image-aion-mp3
        ;;
    *)
        echo "Usage: $0 [rootfs|full]" >&2
        exit 2
        ;;
esac

